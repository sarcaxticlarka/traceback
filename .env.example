FALKORDB_HOST=localhost
FALKORDB_PORT=6390
FALKORDB_PASSWORD=
# Optional server-side default LLM keys (users can also bring their own keys in the console).
# Without any key everything runs with the deterministic offline planner.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
TBK_LLM_MODEL=claude-sonnet-5-5
# TBK_ALLOW_CUSTOM_BASE_URL=1   # allow user-supplied OpenAI-compatible endpoints (e.g. local Ollama)
TBK_TENANTS=helix,orbit
